{
  "projectName": "office-v3-ui",
  "projectType": "shell-template",
  "version": "1.0.0",
  "faviconPath": "favicon.ico",
  "menuOrientation": "vertical",
  "selectedTheme": "dark-theme",
  "useWebXPanel": true,
  "forceDeviceXPanel": false,
  "themes": [
    {
      "name": "light-theme",
      "brandLogo": {
        "url": "./app/template/assets/img/ch5-logo-light.svg",
        "alt": "Crestron Logo",
        "receiveStateUrl": ""
      }
    },
    {
      "name": "dark-theme",
