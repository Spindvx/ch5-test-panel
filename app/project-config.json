{
  "projectName": "office-v3-ui",
  "projectType": "shell-template",
  "version": "1.0.0",
  "faviconPath": "favicon.ico",
  "menuOrientation": "none",
  "selectedTheme": "dark-theme",
  "useWebXPanel": false,
  "forceDeviceXPanel": false,
  "themes": [
    {
      "name": "dark-theme",
      "brandLogo": {
        "url": "./app/template/assets/img/ch5-logo-dark.svg",
        "alt": "Crestron Logo",
        "receiveStateUrl": ""
      }
    }
  ],
  "config": {
    "controlSystem": {
      "host": "192.168.50.113",
      "ipId": "0x03",
      "port": 41794
    }
  },
  "customSignals": {
    "receiveStateTheme": "templateTheme",
    "sendEventTheme": "templateTheme",
    "receiveStateLanguage": "templateLanguage",
    "sendEventLanguage": "templateLanguage"
  },
  "header": {
    "display": false,
    "displayInfo": false,
    "displayTheme": false,
    "diagnostics": {
      "logs": {
        "logAfterProjectLoad": false,
        "receiveStateLogDiagnostics": "",
        "logDiagnostics": "none"
      }
    },
    "$component": ""
  },
  "footer": {
    "display": false,
    "$component": ""
  },
  "content": {
    "$defaultView": "mainpage",
    "triggerViewProperties": {
      "gestureable": false,
      "disableAnimation": true
    },
    "pages": [
      {
        "pageName": "mainpage",
        "fullPath": "./app/project/components/pages/mainpage/",
        "fileName": "mainpage.html",
        "preloadPage": true,
        "cachePage": true,
        "standAloneView": false,
        "navigation": {
          "sequence": 1,
          "label": "Office",
          "isI18nLabel": false,
          "iconClass": "",
          "iconUrl": "",
          "iconPosition": "top"
        },
        "animation": {
          "transitionIn": "",
          "transitionOut": "",
          "transitionDuration": "0s",
          "transitionDelay": "0s"
        }
      }
    ],
    "widgets": [
      { "widgetName": "nvxcontrol",  "fullPath": "./app/project/components/widgets/nvxcontrol/",  "fileName": "nvxcontrol.html" },
      { "widgetName": "qsyslevels",  "fullPath": "./app/project/components/widgets/qsyslevels/",  "fileName": "qsyslevels.html" },
      { "widgetName": "appletv",     "fullPath": "./app/project/components/widgets/appletv/",     "fileName": "appletv.html" },
      { "widgetName": "settings",    "fullPath": "./app/project/components/widgets/settings/",    "fileName": "settings.html" },
      { "widgetName": "musicplayer", "fullPath": "./app/project/components/widgets/musicplayer/", "fileName": "musicplayer.html" },
      { "widgetName": "initilizing", "fullPath": "./app/project/components/widgets/initilizing/", "fileName": "initilizing.html" }
    ]
  }
}
